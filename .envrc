# Enter this repo's flake dev shell (provides pre-commit).
use flake

# Keep the Git pre-commit hook installed when entering the directory.
# This runs quietly and safely on every load.
if command -v pre-commit >/dev/null 2>&1; then
  hook=".git/hooks/pre-commit"
  needs_install=false

  if [[ ! -x "$hook" ]]; then
    needs_install=true
  elif ! rg -q "pre-commit" "$hook"; then
    needs_install=true
  fi

  if [[ "$needs_install" == true ]]; then
    pre-commit install -f >/dev/null 2>&1 || true
  fi
fi
