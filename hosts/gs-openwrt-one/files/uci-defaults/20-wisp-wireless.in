#!/bin/sh
# Wireless config for WISP mode. @WWAN_*@ / @AP_*@ are substituted at build
# time from sops-encrypted secrets (see hosts/gs-openwrt-one/default.nix,
# Makefile `gs-openwrt-one`). Runs once on first boot of a fresh flash, then
# self-deletes.
#
# Confirmed live on this unit: radio0 = 2.4GHz, radio1 = 5GHz. Uplink runs on
# 5GHz (radio1): PCVirus broadcasts on both bands, but 5GHz (ch161) is far less
# congested here (30+ APs crowd 2.4GHz) and leaves more headroom. Local AP is on
# 2.4GHz (radio0); downstream devices are wired via the switch, so its band
# matters little. STA and AP must be on separate radios.
# Encryption 'psk2' = WPA2-PSK; use 'sae' (WPA3) or 'sae-mixed' if upstream changes.

uci -q batch <<'EOF'
# Both radios on; drop the stock open 'OpenWrt' APs that wake up with them.
set wireless.radio0.disabled='0'
set wireless.radio1.disabled='0'
delete wireless.default_radio0
delete wireless.default_radio1

# Uplink STA on radio1 = 5GHz. 'auto' lets it follow the upstream's channel
# (a fixed channel would block association when PCVirus lands elsewhere).
set wireless.radio1.channel='auto'
delete wireless.wwan_sta
set wireless.wwan_sta=wifi-iface
set wireless.wwan_sta.device='radio1'
set wireless.wwan_sta.mode='sta'
set wireless.wwan_sta.network='wwan'
set wireless.wwan_sta.encryption='psk2'

# Local AP on radio0 = 2.4GHz. 'auto' picks the clearest channel.
set wireless.radio0.channel='auto'
delete wireless.local_ap
set wireless.local_ap=wifi-iface
set wireless.local_ap.device='radio0'
set wireless.local_ap.mode='ap'
set wireless.local_ap.network='lan'
set wireless.local_ap.encryption='psk2'
EOF

# Secret values applied outside the heredoc.
uci set wireless.wwan_sta.ssid='@WWAN_SSID@'
uci set wireless.wwan_sta.key='@WWAN_KEY@'
uci set wireless.local_ap.ssid='@AP_SSID@'
uci set wireless.local_ap.key='@AP_KEY@'

uci commit wireless
exit 0
