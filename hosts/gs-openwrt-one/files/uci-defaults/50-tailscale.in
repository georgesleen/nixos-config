#!/bin/sh
# Join the tailnet on first boot as a plain management node (no subnet route:
# gs-pi4 already advertises 192.168.1.0/24, and the LAN hosts that matter have
# their own Tailscale). The reusable auth key is substituted from sops at build
# time (@TS_AUTHKEY@); it is used once, then the node key in
# /etc/tailscale/tailscaled.state carries the node across reboots (disable key
# expiry for this node in the admin console). A `sysupgrade -n` wipes that
# state, so the reusable key re-joins the node.

# Put tailscale0 in the LAN firewall zone so the router is reachable over the
# tailnet for management.
lanzone=$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name=.lan.*/\1/p" | head -n1)
if [ -n "$lanzone" ]; then
    uci -q del_list firewall."$lanzone".device='tailscale0'
    uci add_list firewall."$lanzone".device='tailscale0'
    uci commit firewall
fi

/etc/init.d/tailscale enable
/etc/init.d/tailscale start

# Authenticate once the WISP uplink has internet (backgrounded so first boot
# isn't blocked while the STA associates).
(
    for i in $(seq 1 60); do
        ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && break
        sleep 5
    done
    tailscale up --authkey='@TS_AUTHKEY@' --accept-routes --hostname=gs-openwrt-one
) >/tmp/tailscale-up.log 2>&1 &

exit 0
