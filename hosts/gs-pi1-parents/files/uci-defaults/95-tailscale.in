#!/bin/sh
# Join the tailnet on first boot. @TS_AUTHKEY@ is substituted from sops at build
# time; it is used once, then /etc/tailscale/tailscaled.state carries the node
# across reboots. Disable key expiry for this node in the admin console, or an
# unattended board in another house silently drops off the tailnet in six months.
#
# The advertised subnet is deliberately NOT set here. ts-advertise-routes runs on
# every lan ifup, so the board re-derives its route when it moves to a different
# network; a route baked in at first boot would stay wrong after the move.

# tailscale0 joins the LAN firewall zone so the board is reachable over the
# tailnet, and so traffic arriving on it may be forwarded to the local network.
lanzone=$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name=.lan.*/\1/p" | head -n1)
if [ -n "$lanzone" ]; then
    uci -q del_list firewall."$lanzone".device='tailscale0'
    uci add_list firewall."$lanzone".device='tailscale0'
    # Masquerade forwarded traffic onto the host LAN. Required for both roles:
    # hosts there have no route back to 100.64.0.0/10, so replies would be
    # dropped without SNAT to this board's own address.
    uci set firewall."$lanzone".masq='1'
    uci commit firewall
fi

/etc/init.d/tailscale enable
/etc/init.d/tailscale start

# Authenticate once the network is reachable. Backgrounded so first boot is
# never blocked. ts-advertise-routes then sets the subnet for wherever we are.
(
    for i in $(seq 1 60); do
        ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && break
        sleep 5
    done
    tailscale up --authkey='@TS_AUTHKEY@' --hostname=gs-pi1-parents \
        --advertise-exit-node --ssh
    sh /usr/bin/ts-advertise-routes
) >/tmp/tailscale-up.log 2>&1 &

exit 0
