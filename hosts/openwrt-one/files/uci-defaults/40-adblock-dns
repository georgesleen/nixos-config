#!/bin/sh
# Route LAN DNS through the AdGuard Home on gs-pi4 (adblock + Cloudflare DoH
# upstream). Forwarding targets the pi's stable Tailscale IP (100.126.186.49),
# which AdGuard binds -- so it survives LAN renumbers and doesn't depend on the
# pi's LAN address. gs-pi4 is still pinned at 192.168.10.219 via a DHCP
# reservation. 1.1.1.1 is a strict fallback, so a reboot of the AdGuard host (or
# Tailscale) never takes DNS down.
uci -q batch <<'EOF'
set dhcp.adguard=host
set dhcp.adguard.name='gs-pi4'
set dhcp.adguard.mac='dc:a6:32:1f:4b:7f'
set dhcp.adguard.ip='192.168.10.219'
set dhcp.adguard.dns='1'
set dhcp.@dnsmasq[0].noresolv='1'
set dhcp.@dnsmasq[0].strictorder='1'
delete dhcp.@dnsmasq[0].server
add_list dhcp.@dnsmasq[0].server='100.126.186.49'
add_list dhcp.@dnsmasq[0].server='1.1.1.1'
EOF
uci commit dhcp
exit 0
