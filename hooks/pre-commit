#!/usr/bin/env bash
set -euo pipefail

if ! command -v pedantix >/dev/null 2>&1; then
  echo "[pre-commit] pedantix not found" >&2
  exit 1
fi

if ! command -v nix-instantiate >/dev/null 2>&1; then
  echo "[pre-commit] nix-instantiate not found" >&2
  exit 1
fi

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM | rg '\.nix$' || true)
if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

echo "[pre-commit] formatting ${#staged[@]} staged nix files with pedantix..."
pedantix "${staged[@]}"
git add "${staged[@]}"

echo "[pre-commit] running nix parse on staged files..."
for f in "${staged[@]}"; do
  nix-instantiate --parse "$f" >/dev/null
done
