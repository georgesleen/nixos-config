+		await h.worker.waitForIdle();
+		expect(h.calls.at(-1)?.model.id).toBe(replacement.id);
+		expect(h.calls.at(-1)?.context).toContain("original worker request");
+		expect(h.calls.at(-1)?.context).toContain("next worker request");
