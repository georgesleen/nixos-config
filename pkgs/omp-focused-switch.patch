+		expect(h.calls.at(-1)?.options?.sessionId).toBe(identity);
+		expect(h.settings.getModelRole("default")).toBe(`${original.provider}/${original.id}`);
+		expect(h.main.sessionManager.getEntries()).toHaveLength(0);
+	});
