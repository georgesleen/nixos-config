+			extensionRunner = new ExtensionRunner([extension], runtime, directory.path(), manager, registry);
+		}
+		const agent = new Agent({
+			initialState: {
+				model: original,
+				systemPrompt: [worker ? "Worker identity" : "Main identity"],
+				tools: [],
+				messages: [],
+			},
+			streamFn,
+		});
+		return new AgentSession({
+			agent,
+			sessionManager: manager,
+			settings,
+			modelRegistry: registry,
+			extensionRunner,
+			scopedModels: [{ model: original }, { model: replacement }],
+		});
+	}
+	const main = await createSession(false);
+	const worker = await createSession(true);
+	disposers.push(async () => {
+		releaseCompact.resolve();
+		releaseStream.resolve();
+		await worker.dispose();
+		await main.dispose();
+		auth.close();
