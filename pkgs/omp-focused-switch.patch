+		expect(h.worker.sessionManager.getEntries().slice(0, previous.length)).toEqual(previous);
+		expect(
+			h.worker.sessionManager
+				.getEntries()
+				.some(entry => entry.type === "model_change" && entry.model === selector && entry.role === "temporary"),
+		).toBe(true);
