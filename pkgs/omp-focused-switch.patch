+
+function bundled(id: string): Model {
+	const model = getBundledModel("anthropic", id);
+	if (!model) throw new Error(`Missing bundled model: ${id}`);
+	return model;
+}
+const original = bundled("claude-sonnet-4-5");
+const replacement = bundled("claude-sonnet-4-6");
+const selector = `${replacement.provider}/${replacement.id}`;
+
+function answer(model: Model, failed = false): AssistantMessage {
+	return {
+		role: "assistant",
+		content: failed ? [{ type: "thinking", thinking: "Provider unavailable" }] : [{ type: "text", text: "answer" }],
+		api: model.api,
+		provider: model.provider,
+		model: model.id,
+		stopReason: failed ? "error" : "stop",
+		...(failed ? { errorMessage: "503 service unavailable: overloaded_error retry-after-ms=1" } : {}),
+		usage: {
+			input: 1000,
+			output: 10,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 1010,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		timestamp: Date.now(),
+	};
+}
+
+const disposers: Array<() => Promise<void>> = [];
+afterEach(async () => {
+	vi.restoreAllMocks();
+	for (const dispose of disposers.splice(0)) await dispose();
+});
+
+async function harness(options: { exhausted?: boolean; compact?: "ok" | "cancel" | "failure" } = {}) {
+	const directory = TempDir.createSync("@pi-focused-switch-");
+	const auth = await AuthStorage.create(":memory:");
+	auth.keys.setRuntime("anthropic", "test-key");
+	const registry = new ModelRegistry(auth);
+	const calls: Array<{ model: Model; context: string; options?: SimpleStreamOptions }> = [];
+	const settings = Settings.isolated({
+		"compaction.enabled": false,
+		"compaction.keepRecentTokens": 1,
+		"compaction.experimentalContextManagement": false,
+		"compaction.autoContinue": false,
+		"retry.enabled": options.exhausted ?? false,
+		"retry.maxRetries": 1,
+		"retry.baseDelayMs": 1,
+		"retry.maxDelayMs": 1000,
+		"retry.modelFallback": false,
+		"todo.enabled": false,
+	});
+	settings.setModelRole("default", `${original.provider}/${original.id}`);
+	const compactEntered = Promise.withResolvers<void>();
+	const releaseCompact = Promise.withResolvers<void>();
+	const streamEntered = Promise.withResolvers<void>();
+	const releaseStream = Promise.withResolvers<void>();
+	let parkStream = false;
+	const streamFn: StreamFn = (model, context, streamOptions) => {
+		calls.push({ model, context: JSON.stringify(context), options: streamOptions });
+		const stream = new AssistantMessageEventStream();
+		const parked = parkStream;
+		void (async () => {
+			if (parked) {
+				streamEntered.resolve();
+				await releaseStream.promise;
+			}
+			const message = answer(model, options.exhausted && model.id === original.id);
+			stream.push({ type: "start", partial: message });
+			if (message.stopReason === "error") stream.push({ type: "error", reason: "error", error: message });
+			else stream.push({ type: "done", reason: "stop", message });
+			stream.end();
+		})();
+		return stream;
+	};
+	async function createSession(worker: boolean) {
+		const manager = SessionManager.create(directory.path(), directory.path());
+		let extensionRunner: ExtensionRunner | undefined;
+		if (worker && options.compact) {
+			const runtime = new ExtensionRuntime();
+			const extension = await loadExtensionFromFactory(
+				pi => {
+					pi.on("session_before_compact", async event => {
+						compactEntered.resolve();
+						await releaseCompact.promise;
+						if (options.compact === "cancel") return { cancel: true };
+						return {
+							compaction: {
+								summary: "worker summary",
+								shortSummary: undefined,
+								firstKeptEntryId: event.preparation.firstKeptEntryId,
+								tokensBefore: event.preparation.tokensBefore,
+								details: {},
+							},
+						};
+					});
+				},
+				directory.path(),
+				new EventBus(),
+				runtime,
+				"focused-switch-compaction",
